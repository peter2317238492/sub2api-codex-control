{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api-codex.invalid/schemas/control-images-lock-v1.json",
  "title": "Sub2API Codex Control image release lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "release",
    "release_tag",
    "release_inputs",
    "source",
    "source_bundle",
    "builder",
    "images"
  ],
  "properties": {
    "$schema": {
      "const": "https://sub2api-codex.invalid/schemas/control-images-lock-v1.json"
    },
    "format_version": { "const": 1 },
    "release": { "$ref": "#/$defs/version" },
    "release_tag": { "type": "string", "pattern": "^control-v" },
    "release_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_head", "files"],
      "properties": {
        "migration_head": { "type": "string", "pattern": "^[0-9]{8}_[0-9]{4}$" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "ref"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "$ref": "#/$defs/commit" },
        "ref": { "type": "string", "pattern": "^refs/tags/control-v" }
      }
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "manifest", "attestation"],
      "properties": {
        "archive": { "$ref": "#/$defs/sourceAsset" },
        "manifest": { "$ref": "#/$defs/sourceAsset" },
        "attestation": { "$ref": "#/$defs/sourceAsset" }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_identity",
        "workflow_sha",
        "workflow_trigger",
        "invocation_id",
        "cosign_version",
        "syft_version"
      ],
      "properties": {
        "workflow_identity": { "type": "string", "format": "uri" },
        "workflow_sha": { "$ref": "#/$defs/commit" },
        "workflow_trigger": { "const": "push" },
        "invocation_id": { "type": "string", "format": "uri" },
        "cosign_version": { "type": "string" },
        "syft_version": { "type": "string" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control-api", "pwa", "postgres-tools"],
      "properties": {
        "control-api": { "$ref": "#/$defs/image" },
        "pwa": { "$ref": "#/$defs/image" },
        "postgres-tools": { "$ref": "#/$defs/image" }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "predicate_type"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "predicate_type": { "type": "string", "format": "uri" }
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {
        "filename": {
          "enum": [
            "source.tar",
            "source-files.manifest",
            "source-attestation.json"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "reference",
        "platforms",
        "dockerfile",
        "sbom",
        "provenance"
      ],
      "properties": {
        "repository": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "reference": { "type": "string" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^linux/[a-z0-9_]+$" }
        },
        "dockerfile": { "type": "string" },
        "sbom": { "$ref": "#/$defs/evidence" },
        "provenance": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}

#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset PYTHONPATH PYTHONHOME BASH_ENV ENV CDPATH DOCKER_HOST DOCKER_CONTEXT COMPOSE_FILE COMPOSE_PATH_SEPARATOR
package_root=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")/.." && pwd)
exec /usr/bin/python3 -I "$package_root/lib/server_package.py" lifecycle rollback "$@"

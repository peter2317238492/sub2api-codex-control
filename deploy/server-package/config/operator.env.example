# Copy this file outside the installed package, make it root-owned mode 0600,
# and replace every placeholder. Values are parsed literally; shell expansion is
# never performed. Secrets are referenced by absolute file path only.
CONTROL_COMPOSE_ENV_FILE=/secure/codex-control/compose.env
CONTROL_DEPLOYMENT_RECORD_DIR=/secure/codex-control/release-records
CONTROL_PRODUCTION_BACKUP_ROOT=/secure/codex-control/backups
CONTROL_SMOKE_ACCESS_TOKEN_FILE=/secure/codex-control/smoke-access-token
CONTROL_SMOKE_EXPECTED_USER_ID=replace-with-disposable-fixture-user-id
SUB2API_FIXTURE_ACTIVE_ACCESS_TOKEN_FILE=/secure/codex-control/fixtures/active-access
SUB2API_FIXTURE_ACTIVE_REFRESH_TOKEN_FILE=/secure/codex-control/fixtures/active-refresh
SUB2API_FIXTURE_DISABLED_ACCESS_TOKEN_FILE=/secure/codex-control/fixtures/disabled-access
SUB2API_FIXTURE_REVOKED_ACCESS_TOKEN_FILE=/secure/codex-control/fixtures/revoked-access
SUB2API_FIXTURE_EXPECTED_USER_ID=replace-with-disposable-fixture-user-id
SUB2API_POSTGRES_PASSWORD_FILE=/secure/sub2api/postgres-password
SUB2API_REDIS_PASSWORD_FILE=/secure/sub2api/redis-password
SUB2API_HOST_DATA_PATH=/secure/sub2api/data
SUB2API_HOST_CONFIG_PATH=/secure/sub2api/config.yaml
SUB2API_HOST_COMPOSE_FILE=/secure/sub2api/compose.yaml
SUB2API_HOST_ENV_FILE=/secure/sub2api/.env
# Optional, all four together: admit a Sub2API container whose /app/data is a
# host bind mount (the runtime verifier refuses a bind without this policy).
# SUB2API_HOST_CONFIG_PATH may then be owned by SUB2API_EXPECTED_DATA_BIND_UID.
#SUB2API_EXPECTED_DATA_BIND_SOURCE=/secure/sub2api/data
#SUB2API_EXPECTED_DATA_BIND_UID=1000
#SUB2API_EXPECTED_DATA_BIND_GID=1000
#SUB2API_EXPECTED_DATA_BIND_MODE=0755

# These values must come from the admitted release evidence. Placeholders fail
# collector startup and therefore cannot become a green identity signal.
CONTROL_RELEASE=replace-with-exact-control-release
CONTROL_VCS_REF=replace-with-exact-git-commit

# Obtain with: deploy/monitoring/verify-stack.sh --print-helper-source-sha256
# The helper is a controlled local build, not an immutable registry artifact.
CONTROL_MONITORING_HELPER_SOURCE_SHA256=replace-with-verified-helper-source-closure-sha256

# This is a pre-derived, monitoring-only bearer consumed by both Control API
# replicas and Prometheus. It is not the Control session HMAC secret.
CONTROL_MONITORING_METRICS_BEARER_FILE=/var/lib/codex-control-monitoring/secrets/control_metrics_bearer
CONTROL_MONITORING_ALERTMANAGER_PROXY_BEARER_FILE=/var/lib/codex-control-monitoring/secrets/alertmanager_proxy_bearer
CONTROL_MONITORING_RECEIVER_BEARER_FILE=/var/lib/codex-control-monitoring/secrets/evidence_receiver_bearer
CONTROL_MONITORING_EXTERNAL_OPERATOR_BEARER_FILE=/var/lib/codex-control-monitoring/secrets/external_operator_delivery_bearer
CONTROL_MONITORING_ALERTMANAGER_CONFIG=/var/lib/codex-control-monitoring/config/alertmanager.yml
CONTROL_MONITORING_EXTERNAL_OPERATOR_CONFIG=/var/lib/codex-control-monitoring/config/external-delivery.json

# Both directories must be 0700 and owned by uid/gid 65532. Every input evidence
# file must be a regular, non-symlink 0600 file owned by the same uid.
CONTROL_MONITORING_EVIDENCE_DIR=/var/lib/codex-control-monitoring/evidence
CONTROL_MONITORING_DELIVERY_EVIDENCE_DIR=/var/lib/codex-control-monitoring/delivery-evidence
CONTROL_MONITORING_PROMETHEUS_DATA_DIR=/var/lib/codex-control-monitoring/prometheus
CONTROL_MONITORING_ALERTMANAGER_DATA_DIR=/var/lib/codex-control-monitoring/alertmanager
CONTROL_MONITORING_ALERTMANAGER_BRIDGE_DIR=/var/lib/codex-control-monitoring/alertmanager-bridge

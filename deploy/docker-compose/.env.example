# Immutable release identifiers. Production should use registry image digests,
# not the local image defaults in compose.yaml.
CONTROL_RELEASE=0.1.0
CONTROL_VCS_REF=replace-with-git-commit
CONTROL_API_IMAGE=registry.example.com/sub2api-codex-control-api@sha256:replace-me
CONTROL_PWA_IMAGE=registry.example.com/sub2api-codex-control-pwa@sha256:replace-me
CONTROL_POSTGRES_TOOLS_IMAGE=registry.example.com/sub2api-codex-postgres-tools@sha256:replace-me

# The existing Sub2API network and the only public browser origin.
SUB2API_NETWORK_NAME=sub2api-deploy_sub2api-network
CONTROL_PUBLIC_ORIGIN=https://control.example.com

# Host Nginx reaches these loopback-only ports.
CONTROL_BIND_ADDRESS=127.0.0.1
CONTROL_API_BIND_PORT=18090
CONTROL_API_REPLICA_BIND_PORT=18093
CONTROL_PWA_BIND_PORT=18091
CONTROL_SMOKE_EDGE_BIND_PORT=18092
CONTROL_BACKUP_DIR=./backups
CONTROL_BACKUP_UID_GID=70:70

# Dedicated PostgreSQL database and unprivileged login.
CONTROL_DB_HOST=postgres
CONTROL_DB_PORT=5432
CONTROL_DB_USER=codex_control
CONTROL_DB_NAME=codex_control
# Example when PostgreSQL TLS is configured: ?ssl=require
CONTROL_DB_QUERY=
CONTROL_DATABASE_POOL_SIZE=10
CONTROL_DATABASE_MAX_OVERFLOW=10
CONTROL_DATABASE_POOL_TIMEOUT_SECONDS=3
CONTROL_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CONTROL_DATABASE_COMMAND_TIMEOUT_SECONDS=10

# Dedicated Redis ACL user restricted to CONTROL_REDIS_PREFIX keys/channels.
CONTROL_REDIS_AUTH_MODE=password
CONTROL_REDIS_SCHEME=redis
CONTROL_REDIS_HOST=redis
CONTROL_REDIS_PORT=6379
CONTROL_REDIS_USER=codex_control
CONTROL_REDIS_DATABASE=0
CONTROL_REDIS_QUERY=
CONTROL_REDIS_PREFIX=codex-control:
CONTROL_REDIS_CONNECT_TIMEOUT_SECONDS=3
CONTROL_REDIS_COMMAND_TIMEOUT_SECONDS=3

# One worker is the admission default until cross-instance WebSocket fanout is
# enabled and proven for the release in docs/runbooks/version-matrix.md.
CONTROL_API_WORKERS=1
CONTROL_SESSION_TTL_SECONDS=600
CONTROL_RECENT_AUTH_MAX_AGE_SECONDS=300
CONTROL_OWNER_MAX_ACTIVE_SESSIONS=32
CONTROL_OWNER_MAX_SESSION_RECORDS=10000
CONTROL_CSRF_COOKIE_NAME=codex_csrf
CONTROL_SUB2API_TIMEOUT_SECONDS=5
CONTROL_SUB2API_VERIFY_TLS=true
# Keep UNVERIFIED until verify-sub2api-runtime.sh succeeds against the immutable container.
CONTROL_SUB2API_EXPECTED_VERSION=0.2.1
CONTROL_SUB2API_EXPECTED_COMMIT=578785e
CONTROL_SUB2API_CONTRACT_MARKER=UNVERIFIED
# The same-host Nginx edge overwrites X-Forwarded-For with $remote_addr before
# sending traffic to loopback-only Control API ports. Trust is required so the
# Control API can preserve Sub2API 0.2.1 IP/User-Agent session binding.
CONTROL_TRUST_FORWARDED_FOR=true

# Hard retained-row ceilings fail closed before new durable state is appended.
CONTROL_DEVICE_MAX_APPROVAL_RECORDS=4096
CONTROL_DEVICE_MAX_COMMAND_RECORDS=10000
CONTROL_OWNER_MAX_COMMAND_RECORDS=100000
CONTROL_DEVICE_MAX_CONNECTION_RECORDS=4096
CONTROL_OWNER_MAX_THREAD_RECORDS=1000
CONTROL_OWNER_MAX_APPROVAL_RECORDS=10000
CONTROL_BROWSER_EVENT_CATCHUP_MAX_BYTES=1048576
CONTROL_BROWSER_MAX_CONNECTIONS_PER_SESSION=4
CONTROL_BROWSER_MAX_CONNECTIONS_PER_USER=8
CONTROL_BROWSER_CONNECTION_LEASE_TTL_SECONDS=60

# Secret file paths are resolved by Docker Compose and never placed in the
# container environment by Compose itself.
CONTROL_DATABASE_PASSWORD_SECRET_FILE=./secrets/control_db_password
CONTROL_REDIS_PASSWORD_SECRET_FILE=./secrets/control_redis_password
CONTROL_SESSION_HMAC_SECRET_FILE=./secrets/control_session_hmac_secret

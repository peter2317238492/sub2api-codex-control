# Browser-visible paths must remain same-origin in production.
VITE_CONTROL_API_BASE=/codex-api/v1
VITE_BROWSER_WS_PATH=/codex-ws/browser
VITE_CONTROL_CSRF_COOKIE_NAME=codex_csrf

# The pinned Sub2API frontend key is confirmed during deployment contract freeze.
VITE_SUB2API_ACCESS_TOKEN_KEY=auth_token

# Control API settings are documented in apps/control-api/.env.example.
# Connector settings are documented in connector/connector.example.json.

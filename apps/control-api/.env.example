CONTROL_ENVIRONMENT=development
CONTROL_BUILD_VERSION=0.1.0
CONTROL_BUILD_VCS_REF=unknown

# Use a dedicated PostgreSQL database/role with no access to Sub2API tables.
CONTROL_DATABASE_URL=postgresql+asyncpg://codex_control:change-me@postgres:5432/codex_control
CONTROL_DATABASE_POOL_SIZE=10
CONTROL_DATABASE_MAX_OVERFLOW=20
CONTROL_DATABASE_POOL_TIMEOUT_SECONDS=3
CONTROL_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CONTROL_DATABASE_COMMAND_TIMEOUT_SECONDS=10

# memory:// is accepted only in development/test and is never a production fallback.
CONTROL_REDIS_URL=redis://redis:6379/0
CONTROL_REDIS_PREFIX=codex-control:
CONTROL_REDIS_CONNECT_TIMEOUT_SECONDS=3
CONTROL_REDIS_COMMAND_TIMEOUT_SECONDS=3

CONTROL_SUB2API_BASE_URL=http://sub2api:8080
CONTROL_SUB2API_AUTH_ME_PATH=/api/v1/auth/me
CONTROL_SUB2API_TIMEOUT_SECONDS=5
CONTROL_SUB2API_VERIFY_TLS=true
CONTROL_SUB2API_EXPECTED_VERSION=0.1.178
CONTROL_SUB2API_EXPECTED_COMMIT=e803e38
# Set only after deployment has externally verified the live binary/version contract.
CONTROL_SUB2API_CONTRACT_MARKER=0.1.178/e0c48a1

# Frozen Connector/Codex/app-server control contract.
CONTROL_CONNECTOR_EXPECTED_VERSION=0.1.0
CONTROL_CODEX_EXPECTED_VERSION=0.147.0
CONTROL_APPSERVER_SCHEMA_DIGEST=511c1b3ca038a80740a5a41ca10a7f925c0f744e582fb9aaa03cc46c6e98b80b
# Inject only the exact, externally verified connector-release-metadata.json
# emitted by the signed connector-v release. Production rejects missing,
# oversized, invalid, partial, or contract-drifted metadata; development/test
# project an invalid nonempty value as null and report readiness failure.
CONTROL_CONNECTOR_RELEASE_METADATA_JSON=

# Generate with: openssl rand -base64 48. The literal placeholder below is
# deliberately rejected when CONTROL_ENVIRONMENT=production.
CONTROL_SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
CONTROL_SESSION_TTL_SECONDS=600
# Read-only sessions and browser WebSockets revalidate within this bound.
# Control mutations always revalidate against Sub2API immediately.
CONTROL_SESSION_UPSTREAM_RECHECK_SECONDS=15
CONTROL_RECENT_AUTH_MAX_AGE_SECONDS=300
CONTROL_COOKIE_NAME=__Host-codex_control
CONTROL_CSRF_COOKIE_NAME=codex_csrf
CONTROL_CSRF_HEADER_NAME=x-csrf-token
CONTROL_COOKIE_SECURE=true
CONTROL_COOKIE_SAMESITE=strict

# Exact browser origins, comma-separated, without paths or trailing slashes.
CONTROL_ALLOWED_ORIGINS_CSV=https://control.example.com
CONTROL_EXTERNAL_API_BASE_PATH=/codex-api
CONTROL_SESSION_EXCHANGE_LIMIT=10
CONTROL_OWNER_MAX_ACTIVE_SESSIONS=32
CONTROL_OWNER_MAX_SESSION_RECORDS=10000

CONTROL_PAIRING_TTL_SECONDS=600
CONTROL_PAIRING_START_LIMIT=10
CONTROL_PAIRING_CLAIM_LIMIT=10
CONTROL_PAIRING_POLL_LIMIT=120
CONTROL_PAIRING_POLL_IP_LIMIT=240
CONTROL_RATE_LIMIT_WINDOW_SECONDS=60

# Enable only when direct access is blocked and a trusted reverse proxy overwrites X-Forwarded-For.
CONTROL_TRUST_FORWARDED_FOR=true

CONTROL_DEVICE_ACCESS_TOKEN_TTL_SECONDS=300
CONTROL_DEVICE_TOKEN_ISSUE_LIMIT=30
CONTROL_DEVICE_PROOF_MAX_SKEW_SECONDS=60
CONTROL_DEVICE_NONCE_TTL_SECONDS=300
CONTROL_DEVICE_HELLO_TIMEOUT_SECONDS=10
CONTROL_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
CONTROL_DEVICE_REGISTRY_TTL_SECONDS=90
CONTROL_DEVICE_FRAME_RATE_LIMIT=600
CONTROL_DEVICE_MAX_ENVELOPE_BYTES=262144
CONTROL_DEVICE_MAX_JSON_DEPTH=16
CONTROL_DEVICE_MAX_JSON_NODES=10000
CONTROL_DEVICE_MAX_STRING_CHARS=200000
CONTROL_DEVICE_MAX_RESULT_BYTES=524288
CONTROL_DEVICE_MAX_EVENT_BYTES=262144
CONTROL_DEVICE_MAX_APPROVAL_BYTES=65536
CONTROL_DEVICE_MAX_OUTBOX_FRAMES=2048
CONTROL_DEVICE_MAX_OUTBOX_BYTES=8388608
CONTROL_DEVICE_OUTBOX_RETENTION_SECONDS=604800
CONTROL_DEVICE_MAX_OUTSTANDING_COMMANDS=128
CONTROL_DEVICE_MAX_COMMAND_RECORDS=10000
CONTROL_OWNER_MAX_COMMAND_RECORDS=100000
CONTROL_DEVICE_MAX_CONNECTION_RECORDS=4096
CONTROL_DEVICE_MAX_PENDING_APPROVALS=32
CONTROL_DEVICE_MAX_APPROVAL_RECORDS=4096
CONTROL_BROWSER_EVENT_CATCHUP_LIMIT=500
CONTROL_BROWSER_EVENT_CATCHUP_MAX_BYTES=1048576
CONTROL_BROWSER_EVENT_RETENTION_DAYS=30
CONTROL_BROWSER_EVENT_MAX_PER_OWNER=100000
CONTROL_BROWSER_MAX_CONNECTIONS_PER_SESSION=4
CONTROL_BROWSER_MAX_CONNECTIONS_PER_USER=8
CONTROL_BROWSER_CONNECTION_LEASE_TTL_SECONDS=60
CONTROL_BOOTSTRAP_MAX_DEVICES=100
CONTROL_BOOTSTRAP_MAX_THREADS=100
CONTROL_BOOTSTRAP_MAX_PENDING_APPROVALS=32
CONTROL_BOOTSTRAP_MAX_MODELS_PER_DEVICE=100
CONTROL_BOOTSTRAP_MAX_RESPONSE_BYTES=8388608
CONTROL_OWNER_MAX_DEVICE_RECORDS=1000
CONTROL_OWNER_MAX_THREAD_RECORDS=1000
CONTROL_OWNER_MAX_APPROVAL_RECORDS=10000
CONTROL_COMMAND_TTL_SECONDS=30
CONTROL_COMMAND_SYNC_WAIT_SECONDS=3
CONTROL_APPROVAL_TTL_SECONDS=120
CONTROL_STATE_SWEEP_INTERVAL_SECONDS=1

# Terminal control-plane rows are deleted only after these windows. Active,
# pending, undispatched, and unacknowledged state is never aged away.
CONTROL_SESSION_RECORD_RETENTION_DAYS=7
CONTROL_DEVICE_PAIRING_RETENTION_DAYS=7
CONTROL_DEVICE_CONNECTION_RETENTION_DAYS=30
CONTROL_COMMAND_RECORD_RETENTION_DAYS=30
CONTROL_APPROVAL_RECORD_RETENTION_DAYS=30
CONTROL_THREAD_BINDING_RETENTION_DAYS=90
CONTROL_REVOKED_DEVICE_RETENTION_DAYS=365
CONTROL_AUDIT_EVENT_RETENTION_DAYS=365
CONTROL_RETENTION_SWEEP_BATCH_SIZE=500

# Direct development only. Production entrypoint derives a domain-separated
# bearer token from the file-backed session secret without placing it in Compose.
# The literal placeholder below is also rejected in production.
CONTROL_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
CONTROL_METRICS_CACHE_SECONDS=15
CONTROL_METRICS_QUERY_TIMEOUT_SECONDS=3
